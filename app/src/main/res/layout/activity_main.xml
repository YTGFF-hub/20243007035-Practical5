<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_title_background"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/main_title"
        android:textColor="@color/color_text_light"
        android:textSize="28sp" />

    <ImageView
        android:id="@+id/image_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/content_description_map"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/chinese_municipalities" />

    <TextView
        android:id="@+id/label_municipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/edit_municipality"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/label_i_want_to_know"
        android:textColor="@color/color_text_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_municipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="48dp"
        android:hint="@string/hint_municipality_name"
        android:imeOptions="actionGo"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="48dp"
        android:textColor="@color/color_text_dark"
        android:textSize="16sp" />

</LinearLayout>
